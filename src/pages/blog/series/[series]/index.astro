---
import { getCollection, render } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import {
  seriesSlug,
  getChaptersForSeries,
  chapterSlug,
  readingTime,
} from '../../../../lib/content';

export async function getStaticPaths() {
  const series = await getCollection('series', ({ data }) => !data.draft);
  return series.map((entry) => ({
    params: { series: seriesSlug(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const slug = seriesSlug(entry);
const { Content } = await render(entry);
const chapters = await getChaptersForSeries(slug);
const chapterBySlug = new Map(chapters.map((c) => [chapterSlug(c), c]));
const totalMinutes = chapters.reduce((sum, c) => sum + readingTime(c.body ?? ''), 0);
const firstChapterSlug = entry.data.parts[0]?.chapters[0];
---

<Base title={entry.data.title} description={entry.data.excerpt}>
  <article class="mx-auto max-w-3xl px-6 py-14 sm:px-8 sm:py-20">
    <a
      href="/blog"
      class="-mx-2 inline-block rounded-md px-2 py-1 text-sm text-muted underline decoration-transparent underline-offset-4 transition-colors hover:text-fg hover:decoration-current"
    >
      <span aria-hidden="true">&larr;</span> Back to blog
    </a>

    <header class="mt-8 border-b border-border pb-8">
      <div class="flex flex-wrap items-center gap-x-2.5 gap-y-2 text-xs text-faint">
        <span
          class="rounded-full border border-border bg-surface px-2.5 py-0.5 font-mono font-medium text-muted"
        >
          series
        </span>
        <span aria-hidden="true">&middot;</span>
        <span>{chapters.length} chapters</span>
        <span aria-hidden="true">&middot;</span>
        <span>{totalMinutes} min total</span>
      </div>

      <h1
        class="mt-4 text-balance text-3xl font-semibold leading-tight tracking-tight sm:text-[2.5rem]"
      >
        {entry.data.title}
      </h1>

      <div class="prose mt-5 text-base">
        <Content />
      </div>

      {
        firstChapterSlug && (
          <a
            href={`/blog/series/${slug}/${firstChapterSlug}`}
            class="mt-7 inline-block rounded-lg bg-accent px-4 py-2.5 text-sm font-semibold text-accent-fg transition-colors hover:bg-accent-hover active:scale-[0.98]"
          >
            Start reading <span aria-hidden="true">&rarr;</span>
          </a>
        )
      }
    </header>

    <nav aria-label="Table of contents" class="mt-12 space-y-10">
      {
        entry.data.parts.map((part, partIndex) => (
          <section aria-labelledby={`part-${partIndex}`}>
            <h2
              id={`part-${partIndex}`}
              class="font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-faint"
            >
              Part {partIndex + 1} &middot; {part.title}
            </h2>
            <ol class="mt-4 space-y-2">
              {part.chapters.map((chSlug) => {
                const ch = chapterBySlug.get(chSlug);
                if (!ch) return null;
                return (
                  <li>
                    <a
                      href={`/blog/series/${slug}/${chSlug}`}
                      class="group flex items-baseline justify-between gap-4 rounded-lg border border-border px-5 py-4 transition-colors hover:border-border-strong hover:bg-surface"
                    >
                      <span class="text-fg transition-colors group-hover:text-accent">
                        <span class="mr-2.5 font-mono text-xs tabular-nums text-faint">
                          {String(ch.data.order).padStart(2, '0')}
                        </span>
                        {ch.data.title}
                      </span>
                      <span class="shrink-0 text-xs text-faint">
                        {readingTime(ch.body ?? '')} min
                      </span>
                    </a>
                  </li>
                );
              })}
            </ol>
          </section>
        ))
      }
    </nav>
  </article>
</Base>
