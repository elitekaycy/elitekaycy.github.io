---
import Base from '../layouts/Base.astro';
import EntryCard from '../components/EntryCard.astro';
import { getFeed } from '../lib/content';

const feed = await getFeed();
const recent = feed.slice(0, 8);

const projects = [
  {
    name: 'qkt',
    href: 'https://github.com/elitekaycy/qkt',
    blurb: 'Event-driven trading engine in Kotlin — SQL-like strategy DSL, deterministic backtests, same code live.',
  },
  {
    name: 'qkt-insights',
    href: 'https://github.com/elitekaycy/qkt-insights',
    blurb: 'Analysis and reporting layer over qkt runs.',
  },
  {
    name: 'mt5-gateway',
    href: 'https://github.com/elitekaycy/mt5-gateway',
    blurb: 'Headless REST API for MetaTrader 5 — the real terminal under Wine in Docker, no GUI.',
  },
  {
    name: 'qkt-guardrails',
    href: 'https://github.com/elitekaycy/qkt-guardrails',
    blurb: 'Engine-independent equity watchdog for prop-firm and live MT5 accounts.',
  },
];
---

<Base title="Dickson Anyaele">
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-14 sm:px-8 sm:pt-24">
    <p class="font-mono text-sm text-accent">Hi, I'm Dickson</p>

    <h1
      class="mt-4 text-balance text-3xl font-semibold leading-[1.15] tracking-tight sm:text-[2.75rem]"
    >
      I build systems, infrastructure, and the software that runs on them.
    </h1>

    <p class="mt-6 max-w-2xl text-pretty text-lg leading-relaxed text-muted">
      Distributed systems, software architecture, and AI agents are where I
      like to spend my time. I'm excited about software of all kinds &mdash;
      backend, frontend, data, infrastructure &mdash; and drawn to work that
      leaves room to explore and move between them. I like owning what I
      build, well past the point where the interesting part is done.
    </p>

    <p class="mt-4 max-w-2xl text-pretty text-lg leading-relaxed text-muted">
      Currently deep in <a
        href="https://github.com/elitekaycy/qkt"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-link font-mono text-[0.95em]">qkt</a
      >, <a
        href="https://github.com/elitekaycy/qkt-insights"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-link font-mono text-[0.95em]">qkt-insights</a
      >, <a
        href="https://github.com/elitekaycy/mt5-gateway"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-link font-mono text-[0.95em]">mt5-gateway</a
      >, and <a
        href="https://github.com/elitekaycy/qkt-guardrails"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-link font-mono text-[0.95em]">qkt-guardrails</a
      >, plus AI research around trading and markets. This site is where I
      document the journey: how things get built, what broke, and what I'd do
      differently.
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a
        href="/blog"
        class="rounded-lg bg-accent px-4 py-2.5 text-sm font-semibold text-accent-fg transition-colors hover:bg-accent-hover active:scale-[0.98]"
      >
        Read the blog <span aria-hidden="true">&rarr;</span>
      </a>
      <a
        href="https://github.com/elitekaycy"
        target="_blank"
        rel="me noopener noreferrer"
        class="rounded-lg border border-border px-4 py-2.5 text-sm font-medium text-fg transition-colors hover:border-border-strong hover:bg-surface-hover active:scale-[0.98]"
      >
        GitHub <span class="sr-only">(opens in a new tab)</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
      <a
        href="https://x.com/elitekaycy"
        target="_blank"
        rel="me noopener noreferrer"
        class="rounded-lg border border-border px-4 py-2.5 text-sm font-medium text-fg transition-colors hover:border-border-strong hover:bg-surface-hover active:scale-[0.98]"
      >
        X <span class="sr-only">(opens in a new tab)</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>

  <section
    aria-labelledby="projects-heading"
    class="mx-auto max-w-3xl border-t border-border px-6 py-14 sm:px-8"
  >
    <h2 id="projects-heading" class="text-lg font-semibold tracking-tight">
      What I'm building
    </h2>
    <ul class="mt-6 grid gap-3 sm:grid-cols-2">
      {
        projects.map((project) => (
          <li>
            <a
              href={project.href}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex h-full flex-col rounded-xl border border-border p-5 transition-colors hover:border-border-strong hover:bg-surface"
            >
              <span class="flex items-center gap-1.5 font-mono text-sm font-semibold text-fg">
                {project.name}
                <span
                  aria-hidden="true"
                  class="text-faint transition-transform duration-150 group-hover:translate-x-0.5 group-hover:text-accent"
                >
                  ↗
                </span>
                <span class="sr-only">(opens in a new tab)</span>
              </span>
              <span class="mt-2 text-sm leading-relaxed text-muted">{project.blurb}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section
    aria-labelledby="recent-heading"
    class="mx-auto max-w-3xl border-t border-border px-6 py-14 sm:px-8"
  >
    <div class="mb-7 flex items-baseline justify-between gap-4">
      <h2 id="recent-heading" class="text-lg font-semibold tracking-tight">
        Recent writing
      </h2>
      <a
        href="/blog"
        class="-mx-2 rounded-md px-2 py-1 text-sm text-muted underline decoration-transparent underline-offset-4 transition-colors hover:text-fg hover:decoration-current"
      >
        View all <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
    <ul class="grid gap-4">
      {recent.map((item) => <li><EntryCard item={item} /></li>)}
    </ul>
  </section>
</Base>
