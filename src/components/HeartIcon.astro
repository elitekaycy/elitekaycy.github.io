---
// Outline heart for sponsor links. Size comes from the class prop; colour from --heart.
interface Props {
  class?: string;
}
const { class: cls = 'size-4' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.9"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class:list={['shrink-0 text-heart', cls]}
>
  <path d="M19.5 12.57 12 20l-7.5-7.43A5 5 0 1 1 12 6.01a5 5 0 1 1 7.5 6.56Z"></path>
</svg>
