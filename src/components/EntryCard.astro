---
import type { FeedItem } from '../lib/content';

interface Props {
  item: FeedItem;
}

const { item } = Astro.props;
const formattedDate = item.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<a
  href={item.href}
  class="group block rounded-xl border border-border p-6 transition-colors hover:border-border-strong hover:bg-surface sm:p-7"
>
  <!-- Meta line: smallest type, lowest contrast — scanned, not read. -->
  <div class="flex flex-wrap items-center gap-x-2.5 gap-y-2 text-xs text-faint">
    <time datetime={item.date.toISOString()}>{formattedDate}</time>
    <span aria-hidden="true">&middot;</span>
    <span>{item.minutes} min read</span>
    {
      item.kind === 'series' && (
        <>
          <span aria-hidden="true">&middot;</span>
          <span class="rounded-full border border-border bg-surface px-2 py-0.5 font-mono text-[0.6875rem] font-medium text-muted">
            series &middot; {item.chapterCount} chapters
          </span>
        </>
      )
    }
  </div>

  <!-- Title: the one thing the eye should land on. -->
  <h3
    class="mt-2.5 text-pretty text-lg font-semibold leading-snug tracking-tight text-fg transition-colors group-hover:text-accent"
  >
    {item.title}
  </h3>

  <p class="mt-2 text-pretty text-sm leading-relaxed text-muted">
    {item.excerpt}
  </p>

  {
    item.tags.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-2" aria-label="Tags">
        {item.tags.map((tag) => (
          <li class="rounded-full border border-border px-2.5 py-1 font-mono text-xs text-faint">
            {tag}
          </li>
        ))}
      </ul>
    )
  }
</a>
