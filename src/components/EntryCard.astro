---
import type { FeedItem } from '../lib/content';

interface Props {
  item: FeedItem;
}

const { item } = Astro.props;
const formattedDate = item.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<a
  href={item.href}
  class="group block rounded-xl border p-6 transition-colors sm:p-8"
  style="border-color: var(--border)"
>
  <div class="flex items-center gap-3 text-xs" style="color: var(--fg-muted)">
    <time datetime={item.date.toISOString()}>{formattedDate}</time>
    <span>&middot;</span>
    <span>{item.minutes} min read</span>
    {item.kind === 'series' && (
      <>
        <span>&middot;</span>
        <span class="rounded-full border px-2 py-0.5 font-mono" style="border-color: var(--border)">
          series &middot; {item.chapterCount} chapters
        </span>
      </>
    )}
  </div>
  <h3 class="mt-3 text-lg font-medium transition-colors group-hover:underline" style="color: var(--fg)">
    {item.title}
  </h3>
  <p class="mt-2 text-sm leading-relaxed" style="color: var(--fg-muted)">
    {item.excerpt}
  </p>
  {item.tags.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-2">
      {item.tags.map((tag) => (
        <span class="rounded-full border px-2.5 py-1 text-xs font-mono" style="border-color: var(--border); color: var(--fg-muted)">
          {tag}
        </span>
      ))}
    </div>
  )}
</a>
