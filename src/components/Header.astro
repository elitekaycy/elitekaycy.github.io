---
import ThemeToggle from './ThemeToggle.astro';

const nav = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Blog' },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header
  class="sticky top-0 z-50 border-b border-border bg-bg/85 backdrop-blur-md supports-[backdrop-filter]:bg-bg/70"
>
  <div class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-6 py-4 sm:px-8">
    <!-- Wordmark: one word, two weights — the eye lands on "kaycy". -->
    <a
      href="/"
      class="group -mx-2 rounded-md px-2 py-1.5 font-mono text-[0.9375rem] tracking-tight text-fg transition-colors"
      aria-label="elitekaycy — home"
    >
      <span class="font-medium text-muted transition-colors group-hover:text-fg">elite</span><span
        class="font-bold text-fg">kaycy</span
      >
    </a>

    <nav aria-label="Main" class="flex items-center gap-1 sm:gap-2">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-md px-3 py-2 text-sm transition-colors',
              isActive(item.href)
                ? 'font-semibold text-fg'
                : 'font-normal text-muted hover:bg-surface-hover hover:text-fg',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <ThemeToggle />
    </nav>
  </div>
</header>
